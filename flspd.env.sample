# FLSPD Binary Environment Variables
# Source this file or use it to run the binary locally

# Database Connection
# For local binary running against docker postgres, use localhost:5432
DATABASE_URL=postgres://flspd:flspdpassword@localhost:5432/flspd?sslmode=disable
AUTO_MIGRATE_DATABASE=true

# Server Configuration
LISTEN_ADDRESS=0.0.0.0:9090

# CertMagic (Optional)
# CERTMAGIC_DOMAIN=<DOMAIN>

# Mempool Configuration
MEMPOOL_API_BASE_URL=https://lokichain.info/api/v1/
MEMPOOL_PRIORITY=economy

# Node Configuration
# Option 1: Inline JSON (Overrides NODES_CONFIG_PATH)
# NODES_JSON=[{"name":"FLSP" ...}]

# Option 2: File Path
NODES_CONFIG_PATH=/data/flspd/nodes.json

# Discord Notifications
DISCORD_WEBHOOK_URL=<YOUR_DISCORD_WEBHOOK_URL>
# Set to false to explicitly disable notifications even if URL is present
# DISCORD_NOTIFICATIONS_ENABLED=true
# DISCORD_NOTIFICATIONS_ENABLED=true
 
# LSPS Configuration
# Limits to prevent DOS and resource exhaustion
LSPS1_MAX_PENDING_ORDERS=5
LSPS5_MAX_WEBHOOKS=10

# Logging Configuration
# Directory for log files (default: logs)
LOG_DIR=/data/flspd/logs
# Max size per file before rotation in MB (default: 100)
LOG_MAX_SIZE_MB=100
# Max number of backup files to keep (default: 5)
LOG_MAX_BACKUPS=5
# Max days to retain old log files (default: 30)
LOG_MAX_AGE_DAYS=30
# Compress rotated files with gzip (default: true)
LOG_COMPRESS=true
