{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flspd-frontend",
  "main": "src/worker.ts",
  "compatibility_date": "2024-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "UPSTREAM_API": "https://flsp.flowgate.to/api"
  }
}
