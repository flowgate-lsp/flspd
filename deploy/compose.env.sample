# Docker Compose Environment Variables
# Copy this file to .env before running docker-compose

# Postgres Configuration
POSTGRES_USER=flspd
POSTGRES_PASSWORD=flspdpassword
POSTGRES_DB=flspd

# Discord Notification Configuration
DISCORD_WEBHOOK_URL=<YOUR_DISCORD_WEBHOOK_URL>
# Set to false to explicitly disable notifications even if URL is present
# DISCORD_NOTIFICATIONS_ENABLED=false

# Nostr Configuration (LSPS5)
# Hex-encoded (64 chars) or bech32 (nsec1...) private key for the LSP's Nostr identity
LSP_NOSTR_PRIVATE_KEY=

# Dashboard Configuration
DASHBOARD_ADMIN_PUBKEY=<YOUR_ADMIN_NOSTR_PUBKEY_HEX>
DASHBOARD_LISTEN_ADDRESS=:8080

# Frontend Dev Server Configuration
# Optional. The Vite dev server (web/vite.config.ts) accepts any Host header
# by default so it works behind any dev's reverse-proxy hostname out of the
# box. Set this (comma-separated hostnames) only if you want to lock it back
# down to an explicit allowlist instead.
# VITE_ALLOWED_HOSTS=your-dev-hostname.example.com

# Mempool Configuration
MEMPOOL_API_BASE_URL=https://lokichain.info/api/v1/
MEMPOOL_PRIORITY=economy

# flnd P2P Configuration
# Optional. Set to this host's real public IP so flnd announces a routable
# address to the wider Lightning network (docker-compose.dev.yml passes it
# as --externalip). Left unset, flnd just doesn't announce one -- LSPS1
# clients can still connect directly via the pubkey@host the dashboard
# shows (nodes.yaml's `host`, unrelated to this).
# EXTERNAL_IP=12.34.56.78

# Node Configuration
# Option 1: Inline JSON (Overrides NODES_CONFIG_PATH)
# NODES_JSON=[{"name":"FLSP" ...}]

# Option 2: File Path (Must be absolute or relative to docker-compose.yml on host)
NODES_CONFIG_PATH=./deploy/nodes.yaml

# Logging Configuration
# Directory for log files (default: logs)
LOG_DIR=./data/logs
# Max size per file before rotation in MB (default: 100)
LOG_MAX_SIZE_MB=100
# Max number of backup files to keep (default: 5)
LOG_MAX_BACKUPS=5
# Max days to retain old log files (default: 30)
LOG_MAX_AGE_DAYS=30
# Compress rotated files with gzip (default: true)
LOG_COMPRESS=true

