# flspd image for lokihub's regtest stack, where flspd is the test LSP
# (LP-13). See deploy/regtest/README.md.
#
# Until go.mod requires an nmilat release carrying niplsp (BACKLOG T8-5),
# flspd builds in a Go workspace with an nmilat checkout, passed in as the
# named build context "nmilat":
#
#   docker build -f deploy/Dockerfile.regtest \
#     --build-context nmilat=/path/to/nmilat -t flspd:regtest .
#
# or `just image-regtest /path/to/nmilat`. Once T8-5 lands, deploy/Dockerfile
# builds the same binary and this file can go.

# nmilat's go.mod requires Go 1.26.10, newer than go.mod's 1.26.1. Pinned
# by digest, like deploy/Dockerfile.
FROM golang:1.26.10-alpine@sha256:a2012b4a1d1f9f7e9f44e0d39b805a901e856b1dd80b4e6ee4338db547050308 AS builder

RUN apk add --no-cache git build-base

WORKDIR /src
COPY --from=nmilat go.mod go.sum /src/nmilat/
COPY go.mod go.sum /src/flspd/
RUN cd /src/flspd && go work init . ../nmilat && go mod download

COPY --from=nmilat . /src/nmilat/
COPY . /src/flspd/
# The workspace is created here, never committed (no go.work in the repo).
RUN cd /src/flspd && rm -f go.work go.work.sum && go work init . ../nmilat

ARG TAG=regtest
ARG COMMIT=unknown
RUN cd /src/flspd && CGO_ENABLED=0 go build -trimpath -buildvcs=false \
      -ldflags "-w -s -X github.com/flowgate-lsp/flspd/platform/build.tag=${TAG} -X github.com/flowgate-lsp/flspd/platform/build.revision=${COMMIT}" \
      -o /bin/flspd ./cmd/flspd

FROM alpine:latest@sha256:be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a

RUN apk add --no-cache ca-certificates tzdata \
 && addgroup -S -g 10001 flspd \
 && adduser -S -D -H -u 10001 -G flspd flspd \
 && mkdir -p /var/log/flspd /flspd \
 && chown flspd:flspd /var/log/flspd /flspd

COPY --from=builder /bin/flspd /bin/flspd

# Not root. What it reads (the flnd cert and macaroon) and writes
# (NODES_CONFIG_PATH's directory, LOG_DIR) must be open to uid 10001; the
# regtest compose's flspd-init service prepares both (deploy/regtest).
USER 10001:10001

# 9090: flspd's gRPC (LISTEN_ADDRESS); 8080: dashboard (DASHBOARD_LISTEN_ADDRESS).
# LSPS itself runs over the flnd node's peer connections, not a flspd port.
EXPOSE 9090 8080

ENTRYPOINT ["/bin/flspd"]
